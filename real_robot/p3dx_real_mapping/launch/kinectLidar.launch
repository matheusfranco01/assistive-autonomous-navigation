<launch>
  <!-- =====================================================================
       kinectLidar.launch

       Sobe o sistema completo de mapeamento do Pioneer P3-DX:
         - Driver do robô (RosAria) + joystick
         - LiDAR SICK
         - Câmera RGB-D (Asus/OpenNI2 - Kinect)
         - TFs estáticas (laser e câmera em relação ao base_link)
         - RTAB-Map usando odometria por ICP (laser), NÃO odometria visual
         - GMapping: mapa 2D de ocupação, publicado em paralelo ao 3D

       Por quê ICP e não odometria visual da Kinect?
       A odometria visual (rgbd_odometry) perde a referência quando o
       ambiente tem pouca textura, pouca luz, ou o robô gira rápido
       (motion blur). A odometria por ICP usa o scan do laser SICK, que
       não sofre desses problemas e é bem mais estável em ambientes
       indoor estruturados (corredores, salas). A Kinect continua sendo
       usada para colorir o mapa 3D, só não é mais a fonte de odometria.

       Por que o GMapping não conflita mais com o RTAB-Map?
       Da vez anterior, GMapping e RTAB-Map publicavam a MESMA transformação
       (map -> odom), o que causava conflito de TF. Aqui o GMapping publica
       seu mapa 2D num frame separado, "map2d", em vez de "map". Assim:
         - RTAB-Map publica: map     -> odom -> base_link  (mapa 3D)
         - GMapping   publica: map2d -> odom -> base_link  (mapa 2D)
       Os dois consomem a MESMA odometria (odom -> base_link, vinda do
       icp_odometry) mas publicam mapas em frames diferentes, sem conflito.
       ===================================================================== -->

  <!-- ===================== ARGUMENTOS ===================== -->
  <arg name="joy_config"  default="$(find p3dx_mapping)/config/joystick.yaml" />
  <arg name="lidar_port"  default="/dev/ttyUSB1" />
  <arg name="lidar_baud"  default="19200" />
  <arg name="robot_port"  default="/dev/ttyUSB0" />
  <arg name="scan_topic"  default="/scan" />
  <arg name="use_joy"     default="true" /> <!-- false no WSL2 (sem suporte nativo a joystick): use a ponte UDP em vez disso -->

  <!-- ===================== ROBÔ (RosAria) ===================== -->
  <node pkg="rosaria" type="RosAria" name="RosAria" output="screen">
    <param name="port" value="$(arg robot_port)" />
    <param name="odom_frame" value="wheel_odom" />
  </node>

  <!-- ===================== JOYSTICK ===================== -->
  <group if="$(arg use_joy)">
    <node pkg="joy" type="joy_node" name="joy_node" output="screen" />
    <node pkg="teleop_twist_joy" type="teleop_node" name="teleop_twist_joy" output="screen">
      <rosparam file="$(arg joy_config)" command="load" />
      <remap from="cmd_vel" to="/RosAria/cmd_vel" />
    </node>
  </group>

  <!-- ===================== SICK LIDAR ===================== -->
  <node pkg="sicktoolbox_wrapper" type="sicklms" name="sicklms" output="screen">
    <param name="port" value="$(arg lidar_port)" />
    <param name="baud" value="$(arg lidar_baud)" />
  </node>

  <!-- ===================== CÂMERA RGB-D (Asus/OpenNI2) ===================== -->
  <include file="$(find openni2_launch)/launch/openni2.launch">
    <arg name="depth_registration" value="true" />
  </include>

  <!-- ===================== TFs ESTÁTICAS =====================
       Formato: x y z yaw pitch roll frame_pai frame_filho período(ms)
       AJUSTE os valores de x/y/z conforme a montagem real! -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0.15 0 0.20 0 0 0 base_link laser 100"/>

  <node pkg="tf" type="static_transform_publisher" name="base_to_camera"
        args="0.10 0 0.30 0 0 0 base_link camera_link 100"/>

  <!-- ===================== GMapping (mapa 2D de ocupação) =====================
       Usa a mesma odometria (odom -> base_link) do icp_odometry, mas publica
       seu mapa num frame separado (map2d) para não conflitar com o RTAB-Map. -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="odom_frame" value="odom"/>
    <param name="base_frame" value="base_link"/>
    <param name="map_frame"  value="map2d"/>
    <param name="maxUrange"  value="8.0"/>
    <param name="maxRange"   value="8.0"/>
    <!-- ICP odometry e mais precisa que odometria de roda: reduz ruido assumido e atualiza mapa com mais frequencia -->
    <param name="srr" value="0.05"/>
    <param name="srt" value="0.05"/>
    <param name="str" value="0.05"/>
    <param name="stt" value="0.05"/>
    <param name="linearUpdate" value="0.3"/>
    <param name="angularUpdate" value="0.2"/>
    <!-- Desliga a publicacao de TF do GMapping - ele so gera o mapa 2D, RTAB-Map continua sendo dono da arvore de TF -->
    <param name="transform_publish_period" value="0"/>
  </node>

  <!-- ===================== RTAB-MAP (odometria por ICP no laser) =====================
       Um único nó rtabmap sobe aqui - não incluir outro rtabmap.launch em paralelo! -->
  <include file="$(find rtabmap_ros)/launch/rtabmap.launch">
    <arg name="rtabmap_args"       value="--delete_db_on_start --Grid/Sensor 2 --Vis/MinInliers 10 --Vis/MaxDepth 4.0" />

    <!-- Câmera: usada para colorir o mapa 3D, não para odometria -->
    <arg name="rgb_topic"          value="/camera/rgb/image_rect_color" />
    <arg name="depth_topic"        value="/camera/depth_registered/image_raw" />
    <arg name="camera_info_topic"  value="/camera/rgb/camera_info" />
    <arg name="approx_sync"        value="true" />

    <!-- Referencial do robô (não mais camera_link) -->
    <arg name="frame_id"           value="base_link" />

    <!-- Odometria: ICP via laser, odometria visual desligada -->
    <arg name="visual_odometry"    value="false" />
    <arg name="icp_odometry"       value="true" />
    <arg name="subscribe_scan"     value="true" />
    <arg name="scan_topic"         value="$(arg scan_topic)" />
    <!-- Usa a odometria de roda como chute inicial, ajuda o ICP a nao travar em movimentos rapidos -->
    <arg name="odom_guess_frame_id" value="wheel_odom" />
    <!-- Se a odometria falhar, reinicia automaticamente apos 1 falha em vez de travar -->
    <arg name="odom_args"          value="--Odom/ResetCountdown 1" />
  </include>

  <!-- ===================== RViz ===================== -->
  <node pkg="tf" type="static_transform_publisher" name="map_to_map2d"
        args="0 0 0 0 0 0 map map2d 100"/>

  <node pkg="rviz" type="rviz" name="rviz"/>

</launch>
