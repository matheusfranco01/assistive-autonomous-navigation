<launch>

  <!-- ===================================================== -->
  <!-- ROSARIA (driver do P3DX) -->
  <!-- ===================================================== -->
  <node pkg="rosaria" type="RosAria" name="RosAria" output="screen">
    <param name="port" value="/dev/ttyUSB0"/>
  </node>

  <!-- ===================================================== -->
  <!-- STATIC TF: base_link → camera_link -->
  <!-- Ajuste xyz/rpy conforme a montagem real da Kinect no robô -->
  <!-- ===================================================== -->
  <node pkg="tf" type="static_transform_publisher" name="camera_base_link"
        args="0.15 0.0 0.20 0.0 0.0 0.0 base_link camera_link 100"/>

  <!-- camera_link → camera_rgb_optical_frame (padrão OpenNI) -->
  <node pkg="tf" type="static_transform_publisher" name="camera_rgb_optical"
        args="0.0 -0.03 0.0 -1.5708 0.0 -1.5708 camera_link camera_rgb_optical_frame 100"/>

  <!-- ===================================================== -->
  <!-- SICK LMS200 (LiDAR) -->
  <!-- ===================================================== -->
  <node pkg="sicktoolbox_wrapper" type="sicklms" name="sicklms" output="screen">
    <param name="port"         value="/dev/ttyUSB1"/>
    <param name="baud"         value="19200"/>
    <param name="connect_delay" value="30"/>
  </node>

  <!-- Static TF: base_link → laser -->
  <node pkg="tf" type="static_transform_publisher" name="laser_base_link"
        args="0.10 0.0 0.15 0.0 0.0 0.0 base_link laser 100"/>

  <!-- ===================================================== -->
  <!-- RGB-D ODOMETRY -->
  <!-- ===================================================== -->
  <node pkg="rtabmap_odom" type="rgbd_odometry" name="rgbd_odometry" output="screen">
    <!-- frame_id agora é base_link, não a câmera -->
    <param name="frame_id"      value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="publish_tf"    value="true"/>
    <param name="approx_sync"   value="true"/>

    <remap from="rgb/image"       to="/camera/rgb/image_rect_color"/>
    <remap from="depth/image"     to="/camera/depth_registered/image_raw"/>
    <remap from="rgb/camera_info" to="/camera/rgb/camera_info"/>
  </node>

  <!-- ===================================================== -->
  <!-- RTAB-MAP SLAM -->
  <!-- ===================================================== -->
  <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen"
        args="--delete_db_on_start">

    <!-- Frames -->
    <param name="frame_id"     value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="map_frame_id"  value="map"/>

    <!-- Sensores -->
    <param name="subscribe_depth" value="true"/>
    <param name="subscribe_rgb"   value="true"/>
    <param name="subscribe_scan"  value="true"/>   <!-- LiDAR ativado -->
    <param name="approx_sync"     value="true"/>
    <param name="odom_sensor_sync" value="true"/>

    <!-- SLAM -->
    <param name="Mem/IncrementalMemory" value="true"/>
    <param name="Reg/Strategy"          value="1"/>
    <param name="Reg/Force3DoF"         value="false"/>

    <!-- Grid 3D -->
    <param name="Grid/FromDepth"   value="true"/>
    <param name="Grid/3D"          value="true"/>
    <param name="Grid/RayTracing"  value="true"/>

    <!-- Nuvem de pontos -->
    <param name="Cloud/Compute"      value="true"/>
    <param name="Cloud/Normals"      value="true"/>
    <param name="Cloud/UseMapCache"  value="true"/>
    <param name="CloudDecimation"    value="2"/>
    <param name="CloudVoxelSize"     value="0.02"/>

    <!-- Debug -->
    <param name="Rtabmap/PublishRAM"   value="true"/>
    <param name="Rtabmap/PublishStats" value="true"/>

    <!-- Remaps Kinect -->
    <remap from="rgb/image"       to="/camera/rgb/image_rect_color"/>
    <remap from="depth/image"     to="/camera/depth_registered/image_raw"/>
    <remap from="rgb/camera_info" to="/camera/rgb/camera_info"/>
    <remap from="odom"            to="/odom"/>
    <!-- LiDAR -->
    <remap from="scan"            to="/scan"/>
  </node>

  <!-- ===================================================== -->
  <!-- RVIZ -->
  <!-- ===================================================== -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find rtabmap_ros)/launch/config/rgbd_mapping.rviz"/>

</launch>