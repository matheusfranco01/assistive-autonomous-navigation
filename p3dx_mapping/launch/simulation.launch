<launch>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find p3dx_mapping)/worlds/room.world"/>
  </include>

  <include file="$(find p3dx_gazebo)/launch/p3dx.launch">
    <arg name="ns" value="p3dx"/>
    <arg name="x" value="0"/>
    <arg name="y" value="0"/>
    <arg name="z" value="0"/>
  </include>

</launch>